/* worker.js — runs the DSP pipeline off the main thread.
   DSP (dsp.js) is concatenated ahead of this file in the worker blob. */
self.onmessage = function (e) {
  const d = e.data || {};
  if (d.type !== 'process') return;
  const id = d.id;
  try {
    const samples = new Float32Array(d.samples);
    const t0 = Date.now();
    const res = self.DSP.processVoice(samples, d.fs, Object.assign({}, d.options, {
      onProgress: function (stage, frac) {
        self.postMessage({ type: 'progress', id: id, stage: stage, frac: frac });
      },
    }));
    const wav = self.DSP.encodeWAV(res.samples, d.fs);
    res.stats.elapsedMs = Date.now() - t0;
    self.postMessage(
      { type: 'done', id: id, stats: res.stats, samples: res.samples.buffer, wav: wav },
      [res.samples.buffer, wav]
    );
  } catch (err) {
    self.postMessage({ type: 'error', id: id, message: String((err && err.stack) || err) });
  }
};

