<script>
/* app.js — recorder + UI. Depends on window.DSP (dsp.js) and optionally lamejs. */
'use strict';

const TARGET_FS = 22050;          // processing sample rate (plenty for speech, keeps long files light)
const MIN_LUFS = -30, MAX_LUFS = -8;

const $ = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));

const state = {
  stream: null, recorder: null, chunks: [], recording: false,
  startTs: 0, timerId: null, recId: 0, recordings: [],
  audioCtx: null, analyser: null, srcNode: null, rafId: null,
  worker: null, jobs: new Map(), jobSeq: 0, mp3Ready: false,
};

/* ------------------------------ utils ---------------------------------- */
function fmtTime(s) {
  s = Math.max(0, Math.floor(s));
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
  const p = (n) => String(n).padStart(2, '0');
  return h > 0 ? h + ':' + p(m) + ':' + p(ss) : p(m) + ':' + p(ss);
}
function fmtBytes(b) {
  if (b < 1024) return b + ' B';
  if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
  if (b < 1073741824) return (b / 1048576).toFixed(1) + ' MB';
  return (b / 1073741824).toFixed(2) + ' GB';
}
function lufs(v) { return isFinite(v) ? v.toFixed(1) + ' LUFS' : '—'; }
function db(v) { return isFinite(v) ? v.toFixed(1) + ' dB' : '—'; }
function setStatus(t) { $('#status').textContent = t || ''; }

/* ---------------------------- worker setup ----------------------------- */
function initWorker() {
  const dspSrc = document.getElementById('dsp-src').textContent;
  const workerSrc = document.getElementById('worker-src').textContent;
  const blob = new Blob([dspSrc, '\n', workerSrc], { type: 'application/javascript' });
  const w = new Worker(URL.createObjectURL(blob));
  w.onmessage = (e) => {
    const d = e.data || {};
    const job = state.jobs.get(d.id);
    if (!job) return;
    if (d.type === 'progress') job.onProgress(d.stage, d.frac);
    else if (d.type === 'done') { state.jobs.delete(d.id); job.resolve(d); }
    else if (d.type === 'error') { state.jobs.delete(d.id); job.reject(new Error(d.message)); }
  };
  w.onerror = (err) => { console.error('worker error', err); setStatus('Processing worker crashed.'); };
  state.worker = w;
}

function runProcess(samples, fs, options, onProgress) {
  return new Promise((resolve, reject) => {
    const id = ++state.jobSeq;
    state.jobs.set(id, { resolve, reject, onProgress });
    const buf = samples.buffer;
    state.worker.postMessage({ type: 'process', id, samples: buf, fs, options }, [buf]);
  });
}

/* ---------------------------- recording -------------------------------- */
async function listDevices() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
  try {
    const devs = await navigator.mediaDevices.enumerateDevices();
    const inputs = devs.filter((d) => d.kind === 'audioinput');
    const sel = $('#device');
    const cur = sel.value;
    sel.innerHTML = '';
    if (!inputs.length) { sel.innerHTML = '<option value="">Default microphone</option>'; return; }
    inputs.forEach((d, i) => {
      const o = document.createElement('option');
      o.value = d.deviceId;
      o.textContent = d.label || ('Microphone ' + (i + 1));
      sel.appendChild(o);
    });
    if (cur && inputs.some((d) => d.deviceId === cur)) sel.value = cur;
  } catch (e) { /* enumerate can fail before permission; handled on first record */ }
}

function pickMime() {
  const cands = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/mp4', 'audio/aac'];
  for (const c of cands) if (window.MediaRecorder && MediaRecorder.isTypeSupported(c)) return c;
  return '';
}

async function startRecording() {
  try {
    const deviceId = $('#device').value;
    const constraints = { audio: deviceId ? { deviceId: { exact: deviceId }, echoCancellation: false, noiseSuppression: false, autoGainControl: false } : { echoCancellation: false, noiseSuppression: false, autoGainControl: false } };
    setStatus('Requesting microphone…');
    state.stream = await navigator.mediaDevices.getUserMedia(constraints);
  } catch (e) {
    setStatus(micError(e));
    const b = $('#secureBanner');
    if (b) b.hidden = false;
    return;
  }
  await listDevices();

  // level meter
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    state.audioCtx = new AC();
    state.srcNode = state.audioCtx.createMediaStreamSource(state.stream);
    state.analyser = state.audioCtx.createAnalyser();
    state.analyser.fftSize = 1024;
    state.srcNode.connect(state.analyser);
    drawMeter();
  } catch (e) { /* meter optional */ }

  const mime = pickMime();
  state.chunks = [];
  try {
    state.recorder = mime ? new MediaRecorder(state.stream, { mimeType: mime, audioBitsPerSecond: 128000 })
      : new MediaRecorder(state.stream);
  } catch (e) {
    setStatus('Recording not supported in this browser.');
    return;
  }
  state.recorder.ondataavailable = (ev) => { if (ev.data && ev.data.size) state.chunks.push(ev.data); };
  state.recorder.onstop = finalizeRecording;
  state.recorder.start(1000);

  state.recording = true;
  state.startTs = performance.now();
  $('#recBtn').classList.add('recording');
  $('#recBtn').setAttribute('aria-label', 'Stop recording');
  setStatus('Recording…');
  state.timerId = setInterval(() => {
    $('#timer').textContent = fmtTime((performance.now() - state.startTs) / 1000);
  }, 200);
}

function stopRecording() {
  if (!state.recording) return;
  state.recording = false;
  clearInterval(state.timerId);
  $('#recBtn').classList.remove('recording');
  $('#recBtn').setAttribute('aria-label', 'Start recording');
  try { state.recorder.stop(); } catch (e) {}
  if (state.stream) state.stream.getTracks().forEach((t) => t.stop());
  cancelAnimationFrame(state.rafId);
  if (state.audioCtx) { state.audioCtx.close(); state.audioCtx = null; }
  $('#meterFill').style.width = '0%';
  setStatus('Finishing…');
}

function finalizeRecording() {
  const mime = state.recorder.mimeType || 'audio/webm';
  const blob = new Blob(state.chunks, { type: mime });
  const dur = (performance.now() - state.startTs) / 1000;
  if (blob.size < 1200) { setStatus('Recording too short.'); return; }
  const rec = {
    id: ++state.recId,
    name: 'Recording ' + state.recId,
    blob, url: URL.createObjectURL(blob),
    duration: dur, size: blob.size, mime,
    result: null,
  };
  state.recordings.unshift(rec);
  renderList();
  setStatus('Saved — ' + fmtTime(dur) + ', ' + fmtBytes(blob.size));
}

function drawMeter() {
  const a = state.analyser;
  if (!a) return;
  const data = new Float32Array(a.fftSize);
  const loop = () => {
    if (!state.analyser) return;
    a.getFloatTimeDomainData(data);
    let sum = 0;
    for (let i = 0; i < data.length; i++) sum += data[i] * data[i];
    const rms = Math.sqrt(sum / data.length);
    const pct = Math.max(0, Math.min(100, Math.pow(rms, 0.5) * 140));
    $('#meterFill').style.width = pct + '%';
    state.rafId = requestAnimationFrame(loop);
  };
  loop();
}

/* --------------------------- mic help + import ------------------------- */
function isRestrictedContext() {
  return !window.isSecureContext || location.protocol === 'file:';
}

function checkContext() {
  const b = $('#secureBanner');
  if (!b) return;
  if (!navigator.mediaDevices || isRestrictedContext()) {
    const fileProto = location.protocol === 'file:';
    b.hidden = false;
    b.innerHTML =
      '<strong>Microphone access needs a secure page.</strong> ' +
      (fileProto ? 'You opened this file directly, which most browsers restrict for the microphone. ' : '') +
      'The reliable fix is to serve it over a local address: open a terminal in the folder and run ' +
      '<code>python3 -m http.server</code>, then visit <code>http://localhost:8000/voice-recorder.html</code> ' +
      'and allow the microphone. ' +
      'You can also <strong>import an existing audio file</strong> below and use the full clean-up chain without a mic.';
  } else {
    b.hidden = true;
  }
}

function micError(e) {
  const name = e && e.name;
  if (!navigator.mediaDevices) {
    return 'This browser will not expose the microphone on this page. Serve it over http://localhost and reload.';
  }
  if (name === 'NotAllowedError' || name === 'PermissionDeniedError') {
    return 'Microphone permission was denied. Click the lock / site icon in the address bar, set Microphone to “Allow”, then reload. If you opened this as a local file, serve it via http://localhost instead.';
  }
  if (name === 'NotFoundError' || name === 'DevicesNotFoundError') {
    return 'No microphone was found. Connect one and reload.';
  }
  if (name === 'NotReadableError' || name === 'TrackStartError') {
    return 'The microphone is busy — another app or tab is using it. Close it and try again.';
  }
  if (name === 'SecurityError') {
    return 'The browser blocked the microphone for this page. Serve it over http://localhost and reload.';
  }
  return 'Microphone unavailable: ' + (e && e.message ? e.message : e);
}

function importFile(file) {
  if (!file) return;
  if (!/^audio\//.test(file.type) && !/\.(wav|mp3|m4a|aac|ogg|opus|flac|webm)$/i.test(file.name)) {
    alert('Please choose an audio file.');
    return;
  }
  const rec = {
    id: ++state.recId,
    name: file.name.replace(/\.[^.]+$/, '') || ('Imported ' + state.recId),
    blob: file, url: URL.createObjectURL(file),
    duration: 0, size: file.size, mime: file.type || 'audio', result: null,
  };
  state.recordings.unshift(rec);
  renderList();
  setStatus('Imported “' + rec.name + '” — press Clean & master to process it.');
  const a = document.createElement('audio');
  a.preload = 'metadata';
  a.onloadedmetadata = () => { if (isFinite(a.duration)) { rec.duration = a.duration; renderList(); } };
  a.src = rec.url;
}

/* ------------------------------ list UI -------------------------------- */
function renderList() {
  const wrap = $('#recordings');
  if (!state.recordings.length) {
    wrap.innerHTML = '<div class="empty">No recordings yet. Hit record, then process it to clean it up.</div>';
    return;
  }
  wrap.innerHTML = state.recordings.map(cardHTML).join('');
  state.recordings.forEach(bindCard);
}

function cardHTML(r) {
  const res = r.result;
  let resultHTML = '';
  if (res) {
    const st = res.stats;
    const modules = st.applied.map((m) => '<span class="pill done">' + m.replace(/-/g, ' ') + '</span>').join('');
    const dl = [];
    if (res.wavUrl) dl.push('<a class="btn primary" download="' + safeName(r.name) + '-clean.wav" href="' + res.wavUrl + '">Download WAV</a>');
    if (res.mp3Url) dl.push('<a class="btn" download="' + safeName(r.name) + '-clean.mp3" href="' + res.mp3Url + '">Download MP3</a>');
    resultHTML =
      '<div class="stats">' +
        '<div class="stat"><div class="k">Input</div><div class="v">' + lufs(st.inputLoudness) + '</div></div>' +
        '<div class="stat"><div class="k">Output loudness</div><div class="v good">' + lufs(st.outputLoudness) + '</div></div>' +
        '<div class="stat"><div class="k">True peak</div><div class="v">' + (isFinite(st.outputTruePeakDB) ? st.outputTruePeakDB.toFixed(1) + ' dBTP' : '—') + '</div></div>' +
        '<div class="stat"><div class="k">Gain applied</div><div class="v">' + db(st.normGainDB) + '</div></div>' +
      '</div>' +
      '<div style="margin-top:10px">' + modules + '</div>' +
      '<div class="note">Processed in ' + (st.elapsedMs / 1000).toFixed(1) + ' s &middot; ' + TARGET_FS / 1000 + ' kHz mono</div>' +
      (dl.length ? '<div class="actions">' + dl.join('') + '</div>' : '');
  }
  return '' +
    '<div class="rec-item" data-id="' + r.id + '">' +
      '<div class="rec-head">' +
        '<span class="title">' + r.name + '</span>' +
        '<span class="meta">' + fmtTime(r.duration) + ' &middot; ' + fmtBytes(r.size) + '</span>' +
        '<span class="spacer"></span>' +
        '<button class="btn ghost" data-act="rename">Rename</button>' +
        '<button class="btn danger" data-act="delete">Delete</button>' +
      '</div>' +
      '<audio controls src="' + r.url + '"></audio>' +
      '<div class="actions">' +
        '<button class="btn primary" data-act="process">Clean &amp; master</button>' +
        '<a class="btn" download="' + safeName(r.name) + '-raw" href="' + r.url + '">Download original</a>' +
      '</div>' +
      '<div class="progress" data-el="prog"><i></i></div>' +
      '<div class="prog-label" data-el="proglabel"></div>' +
      '<div data-el="result">' + resultHTML + '</div>' +
    '</div>';
}

function safeName(n) { return n.replace(/[^\w.-]+/g, '_'); }

function bindCard(r) {
  const el = $('.rec-item[data-id="' + r.id + '"]');
  if (!el) return;
  $('[data-act="delete"]', el).onclick = () => {
    state.recordings = state.recordings.filter((x) => x !== r);
    URL.revokeObjectURL(r.url);
    if (r.result) { if (r.result.wavUrl) URL.revokeObjectURL(r.result.wavUrl); if (r.result.mp3Url) URL.revokeObjectURL(r.result.mp3Url); }
    renderList();
  };
  $('[data-act="rename"]', el).onclick = () => {
    const nn = prompt('Recording name', r.name);
    if (nn != null && nn.trim()) { r.name = nn.trim(); renderList(); }
  };
  $('[data-act="process"]', el).onclick = () => processRecording(r, el);
}

/* ---------------------------- processing ------------------------------- */
function readOptions() {
  const nr = parseInt($('#nr').value, 10) / 100;
  const tl = $('#target').value;
  const targetLUFS = tl === 'none' ? null : parseFloat(tl);
  return {
    noiseReduction: nr,
    noisePercentile: 0.12,
    clarity: $('#clarity').checked,
    deEss: $('#deess').checked,
    master: $('#master').checked,
    targetLUFS,
    ceilingDB: -1.0,
    formats: { wav: $('#fmtWav').checked, mp3: $('#fmtMp3').checked && state.mp3Ready },
  };
}

async function decodeToMono(blob) {
  const arr = await blob.arrayBuffer();
  const AC = window.AudioContext || window.webkitAudioContext;
  const ctx = new AC();
  const buf = await ctx.decodeAudioData(arr);
  ctx.close();
  const chans = [];
  for (let c = 0; c < buf.numberOfChannels; c++) chans.push(buf.getChannelData(c));
  let mono = DSP.mixToMono(chans);
  if (buf.sampleRate !== TARGET_FS) mono = DSP.resampleLinear(mono, buf.sampleRate, TARGET_FS);
  return mono;
}

async function processRecording(r, el) {
  const opts = readOptions();
  const prog = $('[data-el="prog"]', el);
  const fill = $('i', prog);
  const label = $('[data-el="proglabel"]', el);
  const resultBox = $('[data-el="result"]', el);
  const btn = $('[data-act="process"]', el);

  if (r.duration > 60 * 50) {
    if (!confirm('This recording is ' + fmtTime(r.duration) + ' long. Processing may take a few minutes and use a lot of memory. Continue?')) return;
  }

  btn.disabled = true; btn.textContent = 'Processing…';
  prog.style.display = 'block'; label.style.display = 'block';
  resultBox.innerHTML = '<div class="err" style="color:var(--muted)">Decoding audio…</div>';
  fill.style.width = '3%';
  label.textContent = 'Decoding…';

  let mono;
  try {
    mono = await decodeToMono(r.blob);
  } catch (e) {
    resultBox.innerHTML = '<div class="err">Could not decode this recording: ' + (e && e.message ? e.message : e) + '</div>';
    btn.disabled = false; btn.textContent = 'Clean & master'; prog.style.display = 'none'; label.style.display = 'none';
    return;
  }
  fill.style.width = '8%';

  const stageNames = {
    'analysing': 'Measuring input loudness', 'noise-reduction': 'Removing background noise',
    'clarity': 'Shaping voice clarity', 'loudness': 'Normalising loudness', 'limiting': 'True-peak limiting', 'measuring': 'Measuring output',
  };
  let done;
  try {
    done = await runProcess(mono, TARGET_FS, opts, (stage, frac) => {
      const nm = stageNames[stage] || stage;
      label.textContent = nm + '…';
      let f = 8 + (frac || 0) * 82;
      if (stage !== 'noise-reduction') f = 8 + 82; // non-noise stages are quick
      fill.style.width = Math.min(94, f) + '%';
    });
  } catch (e) {
    resultBox.innerHTML = '<div class="err">Processing failed: ' + (e && e.message ? e.message : e) + '</div>';
    btn.disabled = false; btn.textContent = 'Clean & master'; return;
  }

  const samples = new Float32Array(done.samples);
  const result = { stats: done.stats, wavBlob: null, mp3Blob: null, wavUrl: null, mp3Url: null };

  if (opts.formats.wav) {
    result.wavBlob = new Blob([done.wav], { type: 'audio/wav' });
    result.wavUrl = URL.createObjectURL(result.wavBlob);
  }
  if (opts.formats.mp3 && state.mp3Ready) {
    try {
      label.textContent = 'Encoding MP3…';
      fill.style.width = '95%';
      result.mp3Blob = encodeMP3(samples, TARGET_FS);
      result.mp3Url = URL.createObjectURL(result.mp3Blob);
    } catch (e) { console.warn('MP3 encode failed', e); }
  }

  fill.style.width = '100%';
  label.textContent = 'Done';
  r.result = result;
  btn.disabled = false; btn.textContent = 'Re-process';
  setTimeout(() => { prog.style.display = 'none'; label.style.display = 'none'; }, 900);
  renderList();
}

function encodeMP3(float32, fs) {
  const enc = new lamejs.Mp3Encoder(1, fs, 128);
  const block = 1152;
  const out = [];
  const i16 = new Int16Array(block);
  for (let i = 0; i < float32.length; i += block) {
    const n = Math.min(block, float32.length - i);
    for (let j = 0; j < n; j++) {
      let s = float32[i + j];
      s = s < -1 ? -1 : s > 1 ? 1 : s;
      i16[j] = s < 0 ? s * 0x8000 : s * 0x7fff;
    }
    const chunk = enc.encodeBuffer(i16.subarray(0, n));
    if (chunk.length) out.push(new Int8Array(chunk));
  }
  const end = enc.flush();
  if (end.length) out.push(new Int8Array(end));
  return new Blob(out, { type: 'audio/mpeg' });
}

/* ------------------------------ boot ----------------------------------- */
function loadLame(cb) {
  const urls = [
    'https://cdn.jsdelivr.net/npm/lamejs@1.2.1/lame.min.js',
    'https://unpkg.com/lamejs@1.2.1/lame.min.js',
  ];
  let i = 0;
  const tryNext = () => {
    if (i >= urls.length) { cb(false); return; }
    const s = document.createElement('script');
    s.src = urls[i++];
    s.onload = () => cb(typeof lamejs !== 'undefined');
    s.onerror = tryNext;
    document.head.appendChild(s);
  };
  tryNext();
}

function wireUI() {
  $('#recBtn').onclick = () => (state.recording ? stopRecording() : startRecording());
  $('#importBtn').onclick = () => $('#fileInput').click();
  $('#fileInput').addEventListener('change', (e) => {
    importFile(e.target.files && e.target.files[0]);
    e.target.value = '';
  });
  $('#nr').addEventListener('input', () => {
    const v = parseInt($('#nr').value, 10);
    $('#nrVal').textContent = v === 0 ? 'Off' : v + '%';
  });
  $('#target').addEventListener('change', () => {
    $('#targetHint').textContent = $('#target').value === 'none' ? 'No level change (EQ + cleanup only)' : 'EBU R128 integrated loudness';
  });
  $('#fmtMp3').addEventListener('change', () => {
    if ($('#fmtMp3').checked && !state.mp3Ready) {
      $('#fmtMp3').checked = false;
      alert('MP3 encoder not available offline. WAV export still works. (Connect to the internet and reload to enable MP3.)');
    }
  });
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && e.target === document.body) { e.preventDefault(); $('#recBtn').click(); }
  });
}

function init() {
  initWorker();
  wireUI();
  checkContext();
  listDevices();
  navigator.mediaDevices && navigator.mediaDevices.addEventListener &&
    navigator.mediaDevices.addEventListener('devicechange', listDevices);
  loadLame((ok) => {
    state.mp3Ready = ok;
    const el = $('#mp3state');
    if (ok) { el.textContent = 'MP3 encoder ready'; el.style.color = 'var(--accent2)'; }
    else { $('#fmtMp3').checked = false; el.textContent = 'MP3 unavailable offline — WAV only'; el.style.color = 'var(--dim)'; }
  });
  setStatus('Ready.');
  renderList();
}

document.addEventListener('DOMContentLoaded', init);

</script>
